---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Timeline from '../components/Timeline.astro';
import NowBuilding from '../components/NowBuilding.astro';
import About from '../components/About.astro';
import Tools from '../components/Tools.astro';
import LabList from '../components/LabList.astro';
import Writing from '../components/Writing.astro';
import Credentials from '../components/Credentials.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { site } from '../data/site';
import { absoluteUrl } from '../lib/url';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.jobTitle,
  url: absoluteUrl('', Astro.site),
  email: `mailto:${site.email}`,
  sameAs: [site.links.linkedin, site.links.github],
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.locality,
    addressCountry: site.countryCode,
  },
};
---

<Base title={site.home.title} description={site.home.description} path="" jsonLd={person}>
  <Hero />
  <SelectedWork />
  <Timeline />
  <NowBuilding />
  <About />
  <Tools />
  <LabList />
  <Writing />
  <Credentials />
  <ContactBlock />
</Base>

---
/**
 * Wraps one architecture diagram in a <figure>. A diagram has several layouts
 * (wide, medium, narrow, compact); each variant is shown at the breakpoints given,
 * so the right-sized SVG is visible and the others are removed with display: none.
 */
import DiagramSvg from './DiagramSvg.astro';
import type { LayoutSpec } from '../../lib/diagram';

export type Breakpoint = 'all' | 'sm' | 'md-up' | 'lg-up' | 'xl-up' | 'md-only' | 'below-lg' | 'below-xl';

interface Props {
  uid: string;
  title: string;
  variants: Array<{ layout: LayoutSpec; show: Breakpoint }>;
  caption?: string;
  /** Draw the surface frame here (case study pages); tiles draw their own. */
  framed?: boolean;
  /** Inline style for the frame, used for the view-transition name. */
  frameStyle?: string;
}

const { uid, title, variants, caption, framed = false, frameStyle } = Astro.props;
---

<figure class="diagram">
  <div class:list={['diagram__frame', { 'diagram__frame--framed': framed }]} style={frameStyle}>
    {
      variants.map((variant, index) => (
        <DiagramSvg
          uid={`${uid}-${index}`}
          title={title}
          layout={variant.layout}
          class={variant.show === 'all' ? undefined : `bp-${variant.show}`}
        />
      ))
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .diagram {
    display: grid;
    gap: var(--space-3);
  }

  .diagram__frame--framed {
    padding: var(--space-6);
    border: var(--hairline) solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  @media (max-width: 767.98px) {
    .diagram__frame--framed {
      padding: var(--space-4);
    }
  }

  figcaption {
    max-width: var(--measure);
    font-size: var(--step-small);
    line-height: var(--lh-small);
    color: var(--color-ink-muted);
  }
</style>

---
import CertRow from './CertRow.astro';
import { credentials } from '../data/credentials';
---

<section class="section credentials" aria-labelledby="credentials-title">
  <div class="container">
    <h2 id="credentials-title" class="section__title">Education and certifications</h2>
    <ul class="credentials__list" role="list">
      {credentials.map((credential) => <CertRow credential={credential} />)}
    </ul>
  </div>
</section>

<style>
  .credentials__list {
    max-width: calc(var(--measure) + var(--space-10));
    list-style: none;
  }
</style>

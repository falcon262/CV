---
/**
 * Theme toggle. The accessible name and the icon follow the effective theme
 * through CSS alone, so both are right before any script runs.
 */
---

<button class="theme-toggle" type="button" data-theme-toggle>
  <span class="visually-hidden label label--to-dark">Switch to dark theme</span>
  <span class="visually-hidden label label--to-light">Switch to light theme</span>
  <svg class="icon icon--sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4.25"></circle>
    <path d="M12 2.75v2.5M12 18.75v2.5M2.75 12h2.5M18.75 12h2.5M5.46 5.46l1.77 1.77M16.77 16.77l1.77 1.77M5.46 18.54l1.77-1.77M16.77 7.23l1.77-1.77"></path>
  </svg>
  <svg class="icon icon--moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
    <path d="M20.25 14.53A8.25 8.25 0 0 1 9.47 3.75a8.25 8.25 0 1 0 10.78 10.78Z"></path>
  </svg>
</button>

<script>
  import '../scripts/theme';
</script>

<style>
  .theme-toggle {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: var(--hairline) solid var(--color-rule);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }

  .theme-toggle:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .theme-toggle:active {
    transform: translateY(1px);
  }

  .icon {
    grid-area: 1 / 1;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      transform var(--dur-base) var(--ease-standard),
      opacity var(--dur-base) var(--ease-standard);
  }

  /* Light is effective by default: show the sun, offer dark. */
  .icon--moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  .label--to-light {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon--sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  :global(:root[data-theme='dark']) .icon--moon {
    opacity: 1;
    transform: none;
  }

  :global(:root[data-theme='dark']) .label--to-dark {
    display: none;
  }

  :global(:root[data-theme='dark']) .label--to-light {
    display: inline;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon--sun {
      opacity: 0;
      transform: rotate(90deg) scale(0.6);
    }

    :global(:root:not([data-theme='light'])) .icon--moon {
      opacity: 1;
      transform: none;
    }

    :global(:root:not([data-theme='light'])) .label--to-dark {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .label--to-light {
      display: inline;
    }
  }
</style>

---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from './Base.astro';
import ProgressBar from '../components/ProgressBar.astro';
import CaseNav from '../components/CaseNav.astro';
import { diagramFor } from '../lib/diagrams';

interface Props {
  entry: CollectionEntry<'work'>;
  previous?: CollectionEntry<'work'>;
  next?: CollectionEntry<'work'>;
}

const { entry, previous, next } = Astro.props;
const { title, slug, outcome, client, role, team, when, stack } = entry.data;
const { Content } = await render(entry);
const { component: Diagram, caption } = diagramFor(slug);
---

<Base title={`${title}, Joseph Kofi Asante`} description={outcome} path={`work/${slug}/`} ogType="article">
  <ProgressBar />
  <article class="case">
    <header class="container case__header">
      <h1 class="case__title" style={`view-transition-name: work-${slug}-title`}>{title}</h1>
      <p class="case__outcome">{outcome}</p>
      <dl class="case__meta">
        <div>
          <dt>Client</dt>
          <dd>{client}</dd>
        </div>
        <div>
          <dt>My role</dt>
          <dd>{role}</dd>
        </div>
        {
          team && (
            <div>
              <dt>Team</dt>
              <dd>{team}</dd>
            </div>
          )
        }
        {
          when && (
            <div>
              <dt>When</dt>
              <dd>{when}</dd>
            </div>
          )
        }
        <div class="case__meta-stack">
          <dt>Stack</dt>
          <dd>{stack.join(', ')}</dd>
        </div>
      </dl>
    </header>

    <div class="container case__media">
      <Diagram context="page" caption={caption} framed frameStyle={`view-transition-name: work-${slug}-media`} />
    </div>

    <div class="container">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
  <CaseNav previous={previous} next={next} />
</Base>

<style>
  .case__header {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-8) var(--space-7);
  }

  .case__title {
    max-width: 20ch;
  }

  .case__outcome {
    max-width: var(--measure);
    font-size: var(--step-body-lg);
    line-height: var(--lh-body);
  }

  .case__meta {
    display: grid;
    gap: var(--space-4) var(--gutter);
    max-width: calc(var(--measure) + var(--space-10));
    margin-top: var(--space-3);
    padding-top: var(--space-5);
    border-top: var(--hairline) solid var(--color-rule);
    font-size: var(--step-small);
    line-height: var(--lh-small);
  }

  @media (min-width: 768px) {
    .case__meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case__meta-stack {
      grid-column: 1 / -1;
    }
  }

  .case__meta div {
    display: grid;
    gap: var(--space-1);
  }

  .case__meta dt {
    color: var(--color-ink-muted);
  }

  .case__media {
    padding-bottom: var(--space-7);
  }

  /* Long-form body: Source Serif 4, 68ch at most. */
  .prose {
    max-width: var(--measure);
    padding-bottom: var(--space-8);
    font-family: var(--font-serif);
    font-size: var(--step-serif);
    font-weight: 400;
    line-height: var(--lh-serif);
  }

  .prose :global(h2) {
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
    font-size: var(--step-h3);
    line-height: var(--lh-h3);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p + p),
  .prose :global(p + ul),
  .prose :global(ul + p) {
    margin-top: var(--space-4);
  }

  .prose :global(ul) {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-5);
  }

  .prose :global(li::marker) {
    color: var(--color-ink-muted);
  }

  .prose :global(strong) {
    font-weight: 600;
  }
</style>

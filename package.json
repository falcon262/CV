{
  "name": "joseph-kofi-asante-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio of Joseph Kofi Asante, senior .NET engineer and technical lead.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && node scripts/check-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "size": "node scripts/js-size.mjs",
    "screens": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/screens.ts",
    "og": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/og.ts",
    "cv": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/cv.ts",
    "test:a11y": "playwright test",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "astro": "7.3.5",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "typescript": "6.0.3"
  }
}
